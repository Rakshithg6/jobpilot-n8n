# Copy to .env before running:  cp .env.example .env
# Change the password and encryption key if this ever leaves your laptop.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=n8n

# Any long random string. Used to encrypt stored credentials.
N8N_ENCRYPTION_KEY=local-dev-key-change-before-deploy

TZ=Asia/Kolkata

# ---------------------------------------------------------------------------
# OPTIONAL. Leave blank and the matching workflow branch stays disabled.
# ---------------------------------------------------------------------------

# Free key from https://console.groq.com/keys  (no card needed)
# Unlocks: 05-ai-cover-letter.json
GROQ_API_KEY=

# Free bot from @BotFather, then message the bot once and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# Unlocks: 03-daily-digest.json + 04-error-handler.json notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Adzuna (Europe + India). Free key: https://developer.adzuna.com/signup ---
# Leave blank and workflow 06 skips itself cleanly.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country codes to query. de=Germany, at=Austria, ch=Switzerland, nl, fr, gb, pl, es, it.
# Add "in" for India, "us", "ca", "au", "sg", "br", "mx", "nz", "za" as needed.
ADZUNA_COUNTRIES=de,at,ch,nl,fr,gb,pl,es,it
# Search terms, comma separated. Each term runs against each country.
# Start with one; add more only if your Adzuna plan allows the extra calls.
# ADZUNA_QUERIES=software engineer,ai engineer,sde
ADZUNA_QUERIES=software engineer
# Hard cap on requests per run (countries x terms, truncated term-major).
# 9 countries x 1 term x 2 runs/day = ~540 calls/month, inside the free quota.
# Only raise this after you know your Adzuna plan's limit.
ADZUNA_MAX_REQUESTS=12

# --- Job-alert emails (workflow 07) ---
# Nothing here: the IMAP login is an n8n credential, not an env var.
# Gmail: enable 2FA, create an App Password (16 chars), then in n8n:
#   Credentials > New > IMAP  ->  host imap.gmail.com, port 993, SSL on,
#   user you@gmail.com, password = the app password.
# Then set up job alerts on LinkedIn / Indeed / Naukri so the emails arrive.
